diff --git a/mkembedfont.sh b/mkembedfont.sh
new file mode 100755
index 0000000..770797f
--- /dev/null
+++ b/mkembedfont.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+# Copyright 2026 by Peter Marquardt <wwwutz@users.noreply.github.com>
+# Licensed as xterm, see the notice in embedfont.c.
+#
+# Generate embedded_fonts.h, which embedfont.c compiles into xterm, from the
+# font files given as arguments.  Uses only od and sed.
+set -e
+
+echo "/* generated by mkembedfont.sh - do not edit */"
+n=0
+for font in "$@"; do
+	echo
+	echo "/* ${font##*/} */"
+	echo "static const unsigned char embedded_font_$n[] = {"
+	od -An -v -tx1 "$font" | sed -e 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'
+	echo "};"
+	n=`expr $n + 1`
+done
+
+echo
+echo "static const struct {"
+echo "    const unsigned char *data;"
+echo "    size_t size;"
+echo "} embedded_fonts[] = {"
+n=0
+for font in "$@"; do
+	echo "    { embedded_font_$n, sizeof(embedded_font_$n) },"
+	n=`expr $n + 1`
+done
+echo "};"

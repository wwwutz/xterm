# Hack Braille 3.003 (Hack plus braille; MIT, Bitstream Vera), compiled in by xterm-412-embedded-font.patch
SRCURL[1]="https://beehive.molgen.mpg.de/9d3164696416dac1787155b809fd6787/hack-braille-3.003.tar.gz"

# local names carry the md5: bee reuses any cached file of the same name
PATCHURL+=("https://beehive.molgen.mpg.de/84831508305dd78cc9b8914ffbb417fa/xterm-412-min-contrast.patch xterm-412-min-contrast-84831508.patch")
PATCHURL+=("https://beehive.molgen.mpg.de/8bc2d954890cca8cf2ccd050c28a4e75/xterm-412-embedded-font.patch xterm-412-embedded-font-8bc2d954.patch")


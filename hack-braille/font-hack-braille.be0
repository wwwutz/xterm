#}

#mee_patch() {
#    bee_patch "${@}"
#}

#mee_configure() {
#    bee_configure
#}

#mee_build() {
#    bee_build
#}

mee_install() {
    install -d --mode=755 ${D}${DATAROOTDIR}/fonts/Hack-Braille
    install -m 644 ${S}/HackBraille-*.ttf ${D}${DATAROOTDIR}/fonts/Hack-Braille/
    # the Bitstream Vera License asks for its notice to go with the fonts
    install -d --mode=755 ${D}${DATAROOTDIR}/doc/font-hack-braille
    install -m 644 ${S}/LICENSE.md ${S}/README ${D}${DATAROOTDIR}/doc/font-hack-braille/
}

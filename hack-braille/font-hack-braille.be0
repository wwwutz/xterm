#!/usr/bin/env beesh

# BEE_VERSION font-hack-braille-3.003-0

# Hack 3.003 plus the braille patterns U+2800..U+28FF (for TUI graphs),
# made with mkhackbraille.py (in the tarball); MIT and Bitstream Vera License.
# xterm and xfce4-terminal also have these fonts compiled in.
SRCURL[0]="https://beehive.molgen.mpg.de/9d3164696416dac1787155b809fd6787/hack-braille-3.003.tar.gz"

# PATCHURL+=()

# EXCLUDE+=()

# build_in_sourcedir

